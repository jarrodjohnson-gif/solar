# Required: Google Maps Static API key for fetching satellite imagery
# Get one at: https://console.cloud.google.com/apis/library/maps-backend.googleapis.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Google Geocoding API key (falls back to free Nominatim if not set)
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key_here

# Optional: Roboflow API key (only needed if downloading private models)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
